{:paths ["src"]
 :deps  {org.clojure/clojure {:mvn/version "1.12.5"}
         org.clojure/core.async {:mvn/version "1.9.865"}
         org.replikativ/konserve {:mvn/version "0.9.362"}
         org.replikativ/konserve-s3 {:mvn/version "0.1.37"}
         no.cjohansen/replicant {:mvn/version "2026.07.1"}}
 :aliases
 {:shadow {:extra-deps {thheller/shadow-cljs {:mvn/version "3.4.11"}
                        djblue/portal        {:mvn/version "0.67.1"}}
           :main-opts  ["-m" "shadow.cljs.devtools.cli"]}
  :test  {:extra-paths ["test"]
          :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}
                        io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
          :exec-fn cognitect.test-runner.api/test}
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
          :main-opts  ["-m" "nrepl.cmdline"]}}}
